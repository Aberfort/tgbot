# --- Telegram MTProto (Userbot для читання джерела) ---
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef
SESSION_NAME=sessions/userbot
# Опційно: base64-рядок файлу userbot.session для автоматичного деплою на Railway/хмари
USERBOT_SESSION_B64=

# Канал-джерело (username без @, посилання або числовий ID на кшталт -1001234567890)
SOURCE_CHANNEL=durov

# --- Telegram Bot (Бот для публікації та модерації) ---
BOT_TOKEN=1234567890:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
BOT_SESSION_NAME=sessions/bot

# Цільовий канал, куди публікуються пости (username або ID з -100...)
TARGET_CHANNEL=-1001234567890

# Telegram User ID адміністратора для модерації (можна дізнатись у @userinfobot)
ADMIN_USER_ID=123456789

# --- LLM (Gemini API) ---
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# Підтримується також змінна ANTHROPIC_API_KEY для сумісності зі специфікацією
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-3.5-flash
PROMPT_FILE=prompts/rewrite.txt

# --- Модерація та фільтрація ---
MODERATION=true
MIN_LENGTH=0
# Максимальний розмір одного медіафайлу в МБ (захист диска від великих відео)
MAX_MEDIA_SIZE_MB=50
# Стоп-слова через кому (регістронезалежні)
STOP_WORDS=реклама,промокод,розіграш,казино,ставк,підписуйтесь на наш,партнерський матеріал,донатьте,купуйте

# --- Оформлення та ліміти публікації ---
FOOTER_TEXT=<a href="https://t.me/btsdailyhub">BTS Daily Hub 💜</a>
PUBLISH_DELAY_SEC=300
MAX_POSTS_PER_HOUR=4
MAX_QUEUED_POSTS=4
POST_TTL_MINUTES=45
DAILY_POLL_ENABLED=true
DAILY_POLL_HOUR_UTC=17

# Опційні тихі години у форматі HH:MM-HH:MM (залиште порожнім, щоб вимкнути)
QUIET_HOURS=23:00-07:00

# --- Сховище та шляхи ---
DB_PATH=data/bot.db
MEDIA_TMP_DIR=data/tmp_media
LOG_FILE=logs/bot.log
LOG_LEVEL=INFO
